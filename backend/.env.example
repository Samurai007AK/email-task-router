# Copy to .env and fill in your own values: cp .env.example .env
# Never commit the real .env file.

# At least one of GEMINI_API_KEY / OLLAMA_API_KEY is required to run the LLM.
# Recommended: set OLLAMA_API_KEY (generous free tier); Gemini becomes the fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: pin a Gemini model (comma-separated = tried in order).
# Empty = automatic fallback chain (gemini-3-flash, gemini-3-flash-preview, ...)
GEMINI_MODEL=

# OPTIONAL but RECOMMENDED: Ollama Cloud (https://ollama.com/settings/keys).
# When OLLAMA_API_KEY is set, Gemma runs FIRST (more generous free tier than
# Gemini) and Gemini becomes the fallback. Set OLLAMA_API_KEY alone and you can
# skip Gemini entirely.
OLLAMA_API_KEY=your_ollama_api_key_here

# OPTIONAL: pin an Ollama model (e.g. gemma4:31b). Empty = gemma4:31b.
OLLAMA_MODEL=

# OPTIONAL: base URL for Ollama's OpenAI-compatible endpoint.
# Leave as-is for the official cloud; point at a local server to test offline.
OLLAMA_BASE_URL=https://ollama.com/v1

# Your candidate id (lowercased email) — keep byte-identical everywhere
CANDIDATE_ID=arijitkonar16@gmail.com

# SQLite (WAL mode enabled automatically). Path is relative to backend/.
DATABASE_URL=sqlite+aiosqlite:///./data/tasks.db

# CORS origins (JSON array) — include your deployed frontend URL
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://email-task-router-one.vercel.app"]
